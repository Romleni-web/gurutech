# GURUTECH Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/gurutech

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Admin Credentials
ADMIN_EMAIL=admin@gurutech.co.ke
ADMIN_PASSWORD=admin123

# M-Pesa Daraja API (Production)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# Google Search Console
GSC_SITE_URL=https://yourdomain.com
GSC_VERIFICATION_TOKEN=your-gsc-verification-token

# Site Config
SITE_NAME=GURUTECH
SITE_URL=https://yourdomain.com
SITE_DESCRIPTION=Premium Electronics Store in Kenya
SITE_LOGO=https://yourdomain.com/assets/logo.png
CONTACT_EMAIL=info@gurutech.co.ke
CONTACT_PHONE=+254712345678
BUSINESS_ADDRESS=Kimathi Street, Nairobi, Kenya
BUSINESS_HOURS=Mo-Fr 08:00-18:00, Sa 09:00-16:00

# Social Links
SOCIAL_FACEBOOK=https://facebook.com/gurutech
SOCIAL_INSTAGRAM=https://instagram.com/gurutech
SOCIAL_TWITTER=https://twitter.com/gurutech

# Email (for order confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
